{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/financial-request.schema.json",
  "title": "Financial request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "idempotency_key",
    "request_type",
    "status",
    "currency",
    "total_amount",
    "requester",
    "allocations",
    "evidences"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^FR-[0-9]{4,}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 12,
      "maxLength": 80
    },
    "request_type": {
      "enum": ["supplier_invoice", "advance"]
    },
    "status": {
      "enum": ["draft", "submitted", "processing", "approved", "rejected", "paid", "cancelled"]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "total_amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 2 },
        "reference": { "type": "string", "maxLength": 80 }
      }
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cost_center", "ledger_account", "amount"],
        "properties": {
          "cost_center": { "type": "string", "pattern": "^CC-[A-Z0-9]{3,12}$" },
          "ledger_account": { "type": "string", "pattern": "^[0-9]{4,10}$" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "description": { "type": "string", "maxLength": 180 }
        }
      }
    },
    "evidences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "file_name"],
        "properties": {
          "kind": { "enum": ["invoice", "approval", "other"] },
          "file_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
          "content_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }
        }
      }
    }
  }
}
